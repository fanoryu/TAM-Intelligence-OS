# Normalize all text to LF in the repo and on checkout. The build concatenates source
# files and compares byte-for-byte, so consistent LF endings keep the build reproducible
# across Windows/macOS/Linux.
* text=auto eol=lf

# Binary assets — never touch line endings.
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
